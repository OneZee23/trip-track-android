<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: a backend on the developer's machine over plain HTTP, reached through
  `adb reverse` as localhost (docs/sign-in.md). Release builds keep the platform default, HTTPS only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
