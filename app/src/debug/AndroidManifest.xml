<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A local backend over HTTP, debug only (docs/sign-in.md). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only: a second launcher entry with the map and fog over seeded libraries. -->
        <activity
            android:name=".debug.MapDemoActivity"
            android:exported="true"
            android:label="@string/debug_map_demo_title"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Debug builds only: seeds the trip screens' demo library, then opens the app (adb start). -->
        <activity
            android:name=".debug.SeedActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug builds only: start, pause, resume and stop a recording from adb on a locked phone. -->
        <receiver
            android:name=".debug.BenchRecordingReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
