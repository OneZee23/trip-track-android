# Keep file/line information for manually uploaded Sentry R8 mappings.
-keepattributes SourceFile,LineNumberTable,Signature,InnerClasses,EnclosingMethod,*Annotation*
-renamesourcefileattribute SourceFile

# The artifact wiring check reads this exact compiled field, including an intentionally empty DSN.
-keep class com.onezee.triptrack.BuildConfig { public static final java.lang.String SENTRY_DSN; }

# Room opens the generated database implementation by its name. DAO code is generated by KSP.
-keep class * extends androidx.room.RoomDatabase { *; }
-keep class com.onezee.triptrack.data.db.TripTrackDatabase_Impl { *; }

# Serialization's bundled rules keep generated serializers; preserve named companions too.
-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> { static <1>$* *; }

# MapLibre and Sentry NDK ship their own JNI/reflection consumer rules. NativeFog binds by name.
-keep class com.onezee.triptrack.map.fog.NativeFog { native <methods>; }
-keepclasseswithmembernames,includedescriptorclasses class * { native <methods>; }

# WorkManager persists worker class names across application updates (the app uses a custom factory).
-keepnames class * extends androidx.work.ListenableWorker

# Credential Manager discovers providers through metadata and reflection.
-keep class * implements androidx.credentials.CredentialProvider { *; }
